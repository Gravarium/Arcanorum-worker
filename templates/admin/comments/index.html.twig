{% extends 'admin/layout.html.twig' %}

{% block admin_title %}{{ 'Kommentarprüfung'|trans }}{% endblock %}
{% block admin_breadcrumb %}{{ 'Kommentare'|trans }}{% endblock %}

{% block admin_content %}
    <header class="page-heading">
        <div>
            <p class="eyebrow">{{ 'Community'|trans }}</p>
            <h1 id="seitenueberschrift">{{ 'Kommentare prüfen'|trans }}</h1>
            <p class="muted">{{ 'Neue Kommentare bleiben verborgen, bis sie freigegeben werden. Gemeldete Beiträge stehen zur erneuten Prüfung bereit.'|trans }}</p>
        </div>
    </header>

    <form class="content-search" method="get" action="{{ path('admin_comment_index') }}">
        <label for="comment-search">{{ 'Kommentare suchen'|trans }}</label>
        <input id="comment-search" type="search" name="q" value="{{ search }}" maxlength="100">
        <label for="comment-status">{{ 'Status'|trans }}</label>
        <select id="comment-status" name="status">
            <option value="">{{ 'Alle Status'|trans }}</option>
            {% for status in statuses %}
                <option value="{{ status.value }}"{% if selected_status == status.value %} selected{% endif %}>{{ status.label|trans }}</option>
            {% endfor %}
        </select>
        <button class="button button-secondary" type="submit">{{ 'Filtern'|trans }}</button>
    </form>

    <section class="admin-panel" aria-labelledby="comment-list-heading">
        <header class="panel-heading">
            <div>
                <h2 id="comment-list-heading">{{ 'Eingereichte Kommentare'|trans }}</h2>
                <p>{{ 'Die Liste zeigt höchstens 100 Treffer. Kommentartext wird als reiner Text ausgegeben.'|trans }}</p>
            </div>
        </header>
        <div class="table-wrap">
            <table class="admin-table">
                <caption class="visually-hidden">{{ 'Kommentare zur Moderation'|trans }}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{ 'Kommentar'|trans }}</th>
                        <th scope="col">{{ 'Inhalt'|trans }}</th>
                        <th scope="col">{{ 'Status'|trans }}</th>
                        <th scope="col">{{ 'Eingegangen'|trans }}</th>
                        <th scope="col">{{ 'Aktionen'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for comment in comments %}
                        <tr>
                            <td>
                                <strong>{{ comment.authorName }}</strong>
                                <p class="comment-body">{{ comment.body }}</p>
                                {% if comment.filteredByTerm %}<span class="status-pill is-filtered">{{ 'Wortfilter: %term%'|trans({'%term%': comment.filteredByTerm}) }}</span>{% endif %}
                                {% if comment.reportCount > 0 %}<span class="status-pill is-reported">{{ 'Meldungen: %report_count%'|trans({'%report_count%': comment.reportCount}) }}</span>{% endif %}
                            </td>
                            <td>{{ comment.contentType.label|trans }}<br>{{ comment.contentTitle }}</td>
                            <td><span class="status-pill is-{{ comment.status.value }}">{{ comment.status.label|trans }}</span></td>
                            <td><time datetime="{{ comment.createdAt|date('c') }}">{{ comment.createdAt|date('d.m.Y H:i') }}</time></td>
                            <td>
                                <form action="{{ path('admin_comment_moderate', {id: comment.id}) }}" method="post" class="form-actions">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_comment_action_' ~ comment.id) }}">
                                    <button class="button button-secondary" type="submit" name="action" value="approve">{{ 'Freigeben'|trans }}</button>
                                    <button class="button button-secondary" type="submit" name="action" value="reject">{{ 'Ablehnen'|trans }}</button>
                                    {% if comment.reportCount > 0 %}<button class="button button-secondary" type="submit" name="action" value="clear_reports">{{ 'Meldungen zurücksetzen'|trans }}</button>{% endif %}
                                    <button class="button button-danger" type="submit" name="action" value="delete">{{ 'Löschen'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5"><p class="empty-state">{{ 'Keine Kommentare für diese Auswahl gefunden.'|trans }}</p></td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
