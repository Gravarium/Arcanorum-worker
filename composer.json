{
    "name": "gravarium/arcanorum-worker",
    "description": "Freigegebenes technisches Symfony-Grundgeruest fuer den Arcanorum Walker",
    "type": "project",
    "license": "proprietary",
    "require": {
        "doctrine/doctrine-bundle": "^2.18 || ^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.0",
        "doctrine/orm": "^3.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "php": "^8.5",
        "psr/cache": "^3.0",
        "symfony/cache": "^7.4",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/doctrine-bridge": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/error-handler": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/stopwatch": "^7.4",
        "symfony/string": "^7.4",
        "symfony/twig-bridge": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/var-dumper": "^7.4",
        "symfony/var-exporter": "^7.4",
        "symfony/yaml": "^7.4",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.80",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.0",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/dom-crawler": "^7.4",
        "symfony/options-resolver": "^7.4",
        "symfony/phpunit-bridge": "^7.4",
        "symfony/process": "^7.4",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
