{
  "name": "gravarium/arcanorum",
  "type": "project",
  "license": "proprietary",
  "description": "Private, modular news and video platform.",
  "require": {
    "php": "^8.5",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-sodium": "*",
    "ext-zip": "*",
    "doctrine/doctrine-bundle": "^2.17",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "doctrine/orm": "^3.3",
    "symfony/asset-mapper": "7.4.*",
    "symfony/mailer": "^7.4",
    "symfony/cache": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/form": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/messenger": "7.4.*",
    "symfony/process": "^7.4",
    "symfony/rate-limiter": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/stimulus-bundle": "^2.0",
    "symfony/twig-bundle": "7.4.*",
    "symfony/translation": "^7.4",
    "symfony/ux-turbo": "^2.0",
    "symfony/validator": "7.4.*",
    "symfony/yaml": "7.4.*",
    "twig/extra-bundle": "^3.0",
    "symfony/runtime": "7.4.*",
    "symfony/var-exporter": "7.4.*",
    "symfony/asset": "7.4.*",
    "symfony/clock": "7.4.*",
    "symfony/error-handler": "7.4.*",
    "symfony/event-dispatcher": "7.4.*",
    "symfony/filesystem": "7.4.*",
    "symfony/finder": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/http-foundation": "7.4.*",
    "symfony/mime": "7.4.*",
    "symfony/options-resolver": "7.4.*",
    "symfony/password-hasher": "7.4.*",
    "symfony/property-access": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/routing": "7.4.*",
    "symfony/security-core": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/security-http": "7.4.*",
    "symfony/stopwatch": "7.4.*",
    "symfony/string": "7.4.*",
    "symfony/twig-bridge": "7.4.*",
    "symfony/type-info": "7.4.*",
    "symfony/var-dumper": "7.4.*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.60",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^12.0",
    "rector/rector": "^2.0",
    "vimeo/psalm": "^6.0",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/dom-crawler": "7.4.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "classmap": [
      "migrations/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.5.0"
    },
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "symfony": {
      "require": "7.4.*"
    }
  }
}
