{% extends 'base.html.twig' %}

{% block title %}{{ 'Video einreichen'|trans }} · {{ site_settings().siteName }}{% endblock %}

{% block body %}
    {{ include('partials/public_site_header.html.twig') }}
    <main class="public-main">
        <section class="public-page-heading">
            <p class="eyebrow">{{ 'Community'|trans }}</p>
            <h1>{{ 'Video einreichen'|trans }}</h1>
            <p class="lead">{{ 'Eingereichte Video- und Audiobeiträge bleiben privat, bis ein Administrator sie geprüft und freigegeben hat. Du kannst eine Video- oder MP3-Datei hochladen oder eine sichere Videoquelle eines unterstützten Providers vorschlagen.'|trans }}</p>
        </section>

        {% for message in app.flashes('public_video_submission_success') %}
            <p class="flash-message is-success" role="status">{{ message|trans }}</p>
        {% endfor %}
        {% for message in app.flashes('public_video_submission_error') %}
            <p class="flash-message is-error" role="alert">{{ message|trans }}</p>
        {% endfor %}

        <form class="comment-form video-submission-form" action="{{ path('public_video_submission_new') }}" method="post" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('public_video_submission') }}">
            <label for="video-submission-title">{{ 'Titel'|trans }}</label>
            <input id="video-submission-title" name="title" value="{{ values.title }}" maxlength="180" required>
            <label for="video-submission-description">{{ 'Beschreibung'|trans }}</label>
            <textarea id="video-submission-description" name="description" maxlength="20000" rows="7">{{ values.description }}</textarea>
            <label for="video-submission-category">{{ 'Kategorie'|trans }}</label>
            <select id="video-submission-category" name="category">
                <option value="">{{ 'Keine Kategorie'|trans }}</option>
                {% for category in categories %}
                    <option value="{{ category.name }}"{% if values.category == category.name %} selected{% endif %}>{{ category.name }}</option>
                {% endfor %}
            </select>
            <label for="video-submission-source">{{ 'Video-URL eines unterstützten Providers'|trans }}</label>
            <input id="video-submission-source" name="source_url" type="url" maxlength="2048" value="{{ values.source_url }}" autocomplete="url">
            <p class="muted">{{ 'Alternativ kannst du eine Video- oder MP3-Datei hochladen. Verwende nur eine der beiden Quellen.'|trans }}</p>
            <label for="video-submission-file">{{ 'Video- oder MP3-Datei (MP4, WebM, Ogg oder MP3, höchstens 32 MiB)'|trans }}</label>
            <input id="video-submission-file" name="video_file" type="file" accept="video/mp4,video/webm,video/ogg,audio/mpeg,.mp3">
            <div class="comment-honeypot" aria-hidden="true">
                <label for="video-submission-website">{{ 'Dieses Feld leer lassen'|trans }}</label>
                <input id="video-submission-website" name="website" type="text" tabindex="-1" autocomplete="off">
            </div>
            <button class="button" type="submit">{{ 'Zur Prüfung einreichen'|trans }}</button>
            <p class="muted">{{ 'Hochgeladene Video- und Audiodateien werden privat gespeichert. Ein Beitrag erscheint erst nach der redaktionellen Freigabe.'|trans }}</p>
        </form>
    </main>
{% endblock %}
