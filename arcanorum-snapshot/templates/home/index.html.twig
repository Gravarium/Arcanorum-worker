{% extends 'base.html.twig' %}

{% block title %}{{ site_settings().siteName }} – {{ 'News und Videos'|trans }}{% endblock %}

{% block stylesheets %}
    {% if featured_uses_videojs %}<link rel="stylesheet" href="{{ asset('third-party/video.js-8.23.4/video-js.min.css') }}">{% endif %}
{% endblock %}

{% block body %}
    {% set latest_public_article = articles|first %}
    {% set portal_headline = site_settings().tagline is not empty ? site_settings().tagline : site_settings().siteName %}
    <div class="portal-home" data-testid="home-portal">
        <section class="portal-hero" aria-labelledby="home-site-heading">
            {% if featured_video and featured_video.thumbnailObjectId and not featured_video.membersOnly %}
                <img class="portal-hero-image" src="{{ path('video_thumbnail', {id: featured_video.id}) }}" alt="" aria-hidden="true" fetchpriority="high">
            {% endif %}
            <div class="portal-hero-shade">
                <div class="portal-topbar">
                    <span>{{ 'News und Videos'|trans }}</span>
                    <nav aria-label="{{ 'Hauptnavigation'|trans }}">
                        <a href="{{ path('public_member_index') }}">{{ 'Mitglieder'|trans }}</a>
                        {% if module_enabled('contact') %}<a href="{{ path('contact_new') }}">{{ 'Kontakt'|trans }}</a>{% endif %}
                    </nav>
                </div>
                {{ include('partials/public_site_header.html.twig') }}
                <div class="portal-hero-copy">
                    <p class="portal-eyebrow">{{ 'Startseite'|trans }}</p>
                    <h1 id="home-site-heading">{{ portal_headline }}</h1>
                    {% if site_settings().seoDescription is not empty %}
                        <p>{{ site_settings().seoDescription }}</p>
                    {% endif %}
                    <div class="portal-hero-actions">
                        <a class="portal-action portal-action-primary" href="{{ path('video_index') }}">{{ 'Videos entdecken'|trans }}</a>
                        {% if module_enabled('news') %}<a class="portal-action" href="{{ path('news_index') }}">{{ 'Alle News'|trans }}</a>{% endif %}
                    </div>
                </div>
            </div>
        </section>

        {% if latest_public_article and not latest_public_article.membersOnly %}
            <div class="portal-ticker" data-testid="home-latest-ticker">
                <span>{{ 'Neueste News'|trans }}</span>
                <span aria-hidden="true">›</span>
                <a href="{{ path('news_show', {slug: latest_public_article.slug}) }}">{{ latest_public_article.title }}</a>
                {% if latest_public_article.summary %}<p>{{ latest_public_article.summary }}</p>{% endif %}
            </div>
        {% endif %}

        {{ advertising_slot('home-top') }}

        <div class="portal-layout" data-testid="home-portal-layout">
            <aside class="portal-rail portal-rail-left" aria-label="{{ 'Hauptnavigation'|trans }}" data-testid="home-left-rail">
                <section class="portal-widget">
                    <h2>{{ 'Hauptnavigation'|trans }}</h2>
                    <nav class="portal-link-list" aria-label="{{ 'Hauptnavigation'|trans }}">
                        <a href="{{ path('platform_home') }}" aria-current="page">{{ 'Startseite'|trans }}</a>
                        <a href="{{ path('video_index') }}">{{ 'Videos'|trans }}</a>
                        <a href="{{ path('video_popular') }}">{{ 'Beliebte Videos'|trans }}</a>
                        <a href="{{ path('video_categories') }}">{{ 'Kategorien'|trans }}</a>
                        {% if module_enabled('news') %}<a href="{{ path('news_index') }}">{{ 'News'|trans }}</a>{% endif %}
                        {% if module_enabled('series') %}<a href="{{ path('series_index') }}">{{ 'Serien'|trans }}</a>{% endif %}
                        {% if module_enabled('pages') %}<a href="{{ path('page_index') }}">{{ 'Seiten'|trans }}</a>{% endif %}
                        <a href="{{ path('public_member_index') }}">{{ 'Mitglieder'|trans }}</a>
                        {% if module_enabled('search') %}<a href="{{ path('public_search') }}">{{ 'Suche'|trans }}</a>{% endif %}
                    </nav>
                </section>

                {% if featured_video_category_sections is not empty %}
                    <section class="portal-widget">
                        <h2>{{ 'Kategorien'|trans }}</h2>
                        <nav class="portal-link-list" aria-label="{{ 'Videokategorien'|trans }}">
                            {% for section in featured_video_category_sections %}<a href="{{ path('video_category', {slug: section.category.slug}) }}">{{ section.category.name }}</a>{% endfor %}
                        </nav>
                    </section>
                {% endif %}

                {% if tag_cloud is not empty %}
                    <section class="portal-widget" aria-labelledby="home-tag-cloud-heading">
                        <h2 id="home-tag-cloud-heading">{{ 'Schlagwörter'|trans }}</h2>
                        <p class="portal-tags" aria-label="{{ 'Öffentliche Video-Schlagwörter'|trans }}">
                            {% for tag in tag_cloud %}<a href="{{ path('video_index', {tag: tag.name}) }}" title="{{ '%count% veröffentlichte Videos'|trans({'%count%': tag.usage_count}) }}">{{ tag.name }}</a>{% endfor %}
                        </p>
                    </section>
                {% endif %}

                {% if public_statistics is not null %}
                    <section class="portal-widget" aria-labelledby="home-public-statistics-heading">
                        <h2 id="home-public-statistics-heading">{{ 'Website-Statistik'|trans }}</h2>
                        <dl class="portal-statistics">
                            <div><dt>{{ 'Öffentliche Videos'|trans }}</dt><dd>{{ public_statistics.videos }}</dd></div>
                            {% if module_enabled('news') %}<div><dt>{{ 'Öffentliche News'|trans }}</dt><dd>{{ public_statistics.news }}</dd></div>{% endif %}
                            <div><dt>{{ 'Öffentliche Mitgliederprofile'|trans }}</dt><dd>{{ public_statistics.members }}</dd></div>
                        </dl>
                    </section>
                {% endif %}
            </aside>

            <main class="public-main portal-main" data-testid="home-main-column">

                {% if featured_video %}
                    <section class="public-section" aria-labelledby="home-featured-heading" data-testid="home-featured-video-section">
                        <div class="public-section-heading">
                            <div><p class="eyebrow">{{ 'Auf der Startseite'|trans }}</p><h2 id="home-featured-heading">{{ 'Hervorgehobene Videos'|trans }}</h2></div>
                        </div>
                        <article class="public-article home-featured-video">
                            <h3><a href="{{ path('video_show', {id: featured_video.id}) }}">{{ featured_video.title }}</a></h3>
                            {% if featured_video.thumbnailObjectId %}<img class="video-thumbnail video-thumbnail-feature" src="{{ path('video_thumbnail', {id: featured_video.id}) }}" alt="{{ 'Vorschaubild für %title%'|trans({'%title%': featured_video.title}) }}" decoding="async">{% endif %}
                            {% if featured_player_available %}
                                <div class="video-stage" data-player-color-scheme="{{ site_settings().videoPlayerColorScheme.value }}">
                                    {% if featured_video.sourceType.value == 'file' %}
                                        {% if featured_video.isAudio %}
                                            <audio id="audio-player-{{ featured_video.id }}" class="audio-player" data-testid="home-featured-audio-file" controls preload="{{ site_settings().videoPreloadMode.value }}" aria-label="{{ featured_video.title }}">
                                                <source src="{{ path('video_media', {id: featured_video.id}) }}" type="{{ featured_video.uploadedMimeType }}">
                                                {% for subtitle in featured_subtitle_tracks %}<track kind="subtitles" src="{{ path('video_subtitle_track', {videoId: featured_video.id, trackId: subtitle.id}) }}" srclang="{{ subtitle.languageCode }}" label="{{ subtitle.label }}"{% if loop.first %} default{% endif %}>{% endfor %}
                                                {{ 'Dein Browser kann diese Audiodatei nicht abspielen.'|trans }}
                                            </audio>
                                        {% else %}
                                            <video id="video-player-{{ featured_video.id }}" data-testid="home-featured-video" data-player-aspect-ratio="{{ site_settings().videoPlayerAspectRatio.value }}" data-player-max-width="{{ site_settings().videoPlayerHomeMaxWidth.value }}" controls preload="{{ site_settings().videoPreloadMode.value }}" playsinline aria-label="{{ featured_video.title }}"{% if featured_uses_videojs %} class="video-js vjs-default-skin" data-video-player-engine="videojs" data-player-message-ready="{{ 'Video ist bereit.'|trans }}" data-player-message-error="{{ 'Die Video-Wiedergabe ist derzeit nicht verfügbar.'|trans }}"{% endif %}{% if featured_autoplay %} autoplay muted{% endif %}>
                                                <source src="{{ path('video_media', {id: featured_video.id}) }}" type="{{ featured_video.uploadedMimeType }}">
                                                {% for subtitle in featured_subtitle_tracks %}<track kind="subtitles" src="{{ path('video_subtitle_track', {videoId: featured_video.id, trackId: subtitle.id}) }}" srclang="{{ subtitle.languageCode }}" label="{{ subtitle.label }}"{% if loop.first %} default{% endif %}>{% endfor %}
                                                {{ 'Dein Browser kann dieses Video nicht abspielen.'|trans }}
                                            </video>
                                            {{ include('partials/video_quality_selector.html.twig', {player_id: 'video-player-' ~ featured_video.id, base_source_url: path('video_media', {id: featured_video.id}), base_source_mime: featured_video.uploadedMimeType, quality_sources: featured_quality_sources}) }}
                                            {% if featured_uses_videojs %}<p data-video-player-status role="status">{{ 'Video-Player wird vorbereitet.'|trans }}</p>{% endif %}
                                        {% endif %}
                                    {% elseif featured_video.sourceType.value == 'stream' and featured_stream_source %}
                                        {% if featured_stream_source.isAudio %}
                                            <audio id="audio-player-{{ featured_video.id }}" class="audio-player" data-testid="home-featured-audio-stream" controls preload="{{ site_settings().videoPreloadMode.value }}" referrerpolicy="no-referrer" aria-label="{{ featured_video.title }}">
                                                <source src="{{ featured_stream_source.url }}" type="{{ featured_stream_source.mimeType }}">
                                                {% for subtitle in featured_subtitle_tracks %}<track kind="subtitles" src="{{ path('video_subtitle_track', {videoId: featured_video.id, trackId: subtitle.id}) }}" srclang="{{ subtitle.languageCode }}" label="{{ subtitle.label }}"{% if loop.first %} default{% endif %}>{% endfor %}
                                                {{ 'Dein Browser kann diesen Audiostream nicht abspielen.'|trans }}
                                            </audio>
                                        {% else %}
                                            <video id="video-player-{{ featured_video.id }}" data-testid="home-featured-video" data-player-aspect-ratio="{{ site_settings().videoPlayerAspectRatio.value }}" data-player-max-width="{{ site_settings().videoPlayerHomeMaxWidth.value }}" controls preload="{{ site_settings().videoPreloadMode.value }}" playsinline referrerpolicy="no-referrer" aria-label="{{ featured_video.title }}"{% if featured_uses_videojs %} class="video-js vjs-default-skin" data-video-player-engine="videojs" data-player-message-ready="{{ 'Video ist bereit.'|trans }}" data-player-message-error="{{ 'Die Video-Wiedergabe ist derzeit nicht verfügbar.'|trans }}"{% endif %}{% if featured_autoplay %} autoplay muted{% endif %}{% if featured_uses_hls %} data-hls-url="{{ featured_stream_source.url }}" data-hls-message-invalid-url="{{ 'Dieser Live-Stream ist nicht verfügbar.'|trans }}" data-hls-message-error="{{ 'Der Live-Stream ist derzeit nicht verfügbar. Bitte versuche es später erneut.'|trans }}" data-hls-message-ready="{{ 'Live-Stream bereit. Drücke Wiedergabe.'|trans }}" data-hls-message-unsupported="{{ 'Dieser Browser unterstützt die Live-Wiedergabe nicht. Nutze den Link zum Stream.'|trans }}"{% endif %}>
                                                {% if not featured_uses_hls %}<source src="{{ featured_stream_source.url }}" type="{{ featured_stream_source.mimeType }}">{% endif %}
                                                {% for subtitle in featured_subtitle_tracks %}<track kind="subtitles" src="{{ path('video_subtitle_track', {videoId: featured_video.id, trackId: subtitle.id}) }}" srclang="{{ subtitle.languageCode }}" label="{{ subtitle.label }}"{% if loop.first %} default{% endif %}>{% endfor %}
                                                {{ 'Dein Browser kann diesen Stream nicht abspielen.'|trans }}
                                            </video>
                                            {{ include('partials/video_quality_selector.html.twig', {player_id: 'video-player-' ~ featured_video.id, base_source_url: featured_stream_source.url, base_source_mime: featured_stream_source.mimeType, quality_sources: featured_quality_sources}) }}
                                            {% if featured_uses_videojs %}<p data-video-player-status role="status">{{ 'Video-Player wird vorbereitet.'|trans }}</p>{% elseif featured_uses_hls %}<p data-hls-status role="status">{{ 'Live-Stream wird vorbereitet.'|trans }}</p>{% endif %}
                                        {% endif %}
                                    {% endif %}
                                    {% if site_settings().isVideoPlayerWatermarkEnabled and featured_video.sourceType.value in ['file', 'stream'] and not featured_video.isAudio and (featured_stream_source is null or not featured_stream_source.isAudio) %}{{ include('partials/video_player_watermark.html.twig') }}{% endif %}
                                </div>
                            {% else %}
                                <p class="muted">{{ 'Dieses hervorgehobene Video kann auf der Startseite nicht direkt abgespielt werden.'|trans }}</p>
                            {% endif %}
                            <p><a href="{{ path('video_show', {id: featured_video.id}) }}">{{ 'Videodetails öffnen'|trans }}</a></p>
                        </article>
                        {% if featured_video_cards is not empty %}
                            <div class="content-grid" aria-label="{{ 'Weitere hervorgehobene Videos'|trans }}">
                                {% for video in featured_video_cards %}
                                    <article class="content-card">
                                        {% if video.thumbnailObjectId %}<img class="video-thumbnail" src="{{ path('video_thumbnail', {id: video.id}) }}" alt="{{ 'Vorschaubild für %title%'|trans({'%title%': video.title}) }}" loading="lazy" decoding="async">{% endif %}
                                        <p class="card-kicker">{{ video.categoryNames|join(', ') ?: ('Video'|trans) }}</p>
                                        <h3><a href="{{ path('video_show', {id: video.id}) }}">{{ video.title }}</a></h3>
                                        <p>{{ video.description|slice(0, 180) }}</p>
                                        <time datetime="{{ video.publishedAt|date('c') }}">{{ video.publishedAt|date('d.m.Y') }}</time>
                                    </article>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </section>
                {% endif %}

                {% if site_settings().homepageVideoLimit > 0 %}<section class="public-section" aria-labelledby="home-videos-heading">
                    <div class="public-section-heading">
                        <div><p class="eyebrow">{{ 'Videokatalog'|trans }}</p><h2 id="home-videos-heading">{{ 'Neueste Videos'|trans }}</h2></div>
                        <a href="{{ path('video_index') }}">{{ 'Alle Videos'|trans }}</a>
                        <a href="{{ path('video_popular') }}">{{ 'Beliebte Videos'|trans }}</a>
                    </div>
                    <div class="content-grid">
                        {% for video in videos %}
                            <article class="content-card">
                                {% if video.thumbnailObjectId %}<img class="video-thumbnail" src="{{ path('video_thumbnail', {id: video.id}) }}" alt="{{ 'Vorschaubild für %title%'|trans({'%title%': video.title}) }}" loading="lazy" decoding="async">{% endif %}
                                <p class="card-kicker">{{ video.categoryNames|join(', ') ?: ('Video'|trans) }}</p>
                                <h3><a href="{{ path('video_show', {id: video.id}) }}">{{ video.title }}</a></h3>
                                <p>{{ video.description|slice(0, 180) }}</p>
                                <time datetime="{{ video.publishedAt|date('c') }}">{{ video.publishedAt|date('d.m.Y') }}</time>
                            </article>
                        {% else %}
                            <p class="empty-state">{{ (site_settings().homepageVideoLimit > 0 ? 'Noch keine Videos veröffentlicht.' : 'Der Bereich für neue Videos ist ausgeblendet.')|trans }}</p>
                        {% endfor %}
                    </div>
                </section>{% endif %}

                {% for section in featured_video_category_sections %}
                    <section class="public-section" aria-labelledby="home-category-{{ section.category.id }}">
                        <div class="public-section-heading">
                            <div><p class="eyebrow">{{ 'Videokategorie'|trans }}</p><h2 id="home-category-{{ section.category.id }}">{{ section.category.name }}</h2></div>
                            <a href="{{ path('video_category', {slug: section.category.slug}) }}">{{ 'Alle Videos dieser Kategorie'|trans }}</a>
                        </div>
                        <div class="content-grid">
                            {% for video in section.videos %}
                                <article class="content-card">
                                    {% if video.thumbnailObjectId %}<img class="video-thumbnail" src="{{ path('video_thumbnail', {id: video.id}) }}" alt="{{ 'Vorschaubild für %title%'|trans({'%title%': video.title}) }}" loading="lazy" decoding="async">{% endif %}
                                    <h3><a href="{{ path('video_show', {id: video.id}) }}">{{ video.title }}</a></h3>
                                    <p>{{ video.description|slice(0, 180) }}</p>
                                    <time datetime="{{ video.publishedAt|date('c') }}">{{ video.publishedAt|date('d.m.Y') }}</time>
                                </article>
                            {% endfor %}
                        </div>
                    </section>
                {% endfor %}

                {% if module_enabled('news') and articles is not empty %}<section class="public-section" aria-labelledby="home-news-heading">
                    <div class="public-section-heading">
                        <div><p class="eyebrow">{{ 'Redaktion'|trans }}</p><h2 id="home-news-heading">{{ 'Neueste News'|trans }}</h2></div>
                        {% if module_enabled('news') %}<a href="{{ path('news_index') }}">{{ 'Alle News'|trans }}</a>{% endif %}
                    </div>
                    <div class="content-grid">
                        {% for article in articles %}
                            <article class="content-card">
                                {% if article.thumbnailObjectId and not article.membersOnly %}<img class="video-thumbnail" src="{{ path('news_thumbnail', {id: article.id}) }}" alt="{{ 'Vorschaubild für %title%'|trans({'%title%': article.title}) }}" loading="lazy" decoding="async">{% endif %}
                                <p class="card-kicker">{{ article.category ?? ('News'|trans) }}</p>
                                <h3><a href="{{ path('news_show', {slug: article.slug}) }}">{{ article.title }}</a></h3>
                                {% if article.summary %}<p>{{ article.summary }}</p>{% elseif article.membersOnly %}<p>{{ 'Der vollständige Beitrag ist Mitgliedern vorbehalten.'|trans }}</p>{% else %}<p>{{ article.body|striptags|slice(0, 180) }}</p>{% endif %}
                                <time datetime="{{ article.publishedAt|date('c') }}">{{ article.publishedAt|date('d.m.Y') }}</time>
                            </article>
                        {% else %}
                            <p class="empty-state">{{ 'Noch keine News veröffentlicht.'|trans }}</p>
                        {% endfor %}
                    </div>
                </section>{% endif %}
            </main>

            <aside class="portal-rail portal-rail-right" data-testid="home-right-rail">
                {% if top_videos is not empty %}
                    <section class="portal-widget" aria-labelledby="home-popular-videos-heading" data-testid="home-popular-videos">
                        <div class="portal-widget-heading">
                            <h2 id="home-popular-videos-heading">{{ 'Beliebte Videos'|trans }}</h2>
                            <a href="{{ path('video_popular') }}">{{ 'Alle Videos'|trans }}</a>
                        </div>
                        {% for video in top_videos %}
                            <article class="portal-mini{% if video.thumbnailObjectId and not video.membersOnly %} portal-mini-with-thumbnail{% endif %}">
                                {% if video.thumbnailObjectId and not video.membersOnly %}<img src="{{ path('video_thumbnail', {id: video.id}) }}" alt="" loading="lazy" decoding="async">{% endif %}
                                <div>
                                    <a href="{{ path('video_show', {id: video.id}) }}">{{ video.title }}</a>
                                    <small>{{ video.categoryNames|join(', ') ?: ('Video'|trans) }}</small>
                                </div>
                            </article>
                        {% endfor %}
                    </section>
                {% endif %}

                {% if currently_watching_videos is not empty %}
                    <section class="portal-widget" aria-labelledby="currently-watching-heading">
                        <h2 id="currently-watching-heading">{{ 'Kürzlich angesehen'|trans }}</h2>
                        {% for video in currently_watching_videos %}
                            <article class="portal-mini{% if video.thumbnailObjectId and not video.membersOnly %} portal-mini-with-thumbnail{% endif %}">
                                {% if video.thumbnailObjectId and not video.membersOnly %}<img src="{{ path('video_thumbnail', {id: video.id}) }}" alt="" loading="lazy" decoding="async">{% endif %}
                                <div><a href="{{ path('video_show', {id: video.id}) }}">{{ video.title }}</a></div>
                            </article>
                        {% endfor %}
                    </section>
                {% endif %}
            </aside>
        </div>

        <footer class="portal-footer">
            <div class="portal-footer-grid">
                <div class="portal-footer-brand">
                    <a href="{{ path('platform_home') }}">{{ site_settings().siteName }}</a>
                    {% if site_settings().tagline is not empty %}<p>{{ site_settings().tagline }}</p>{% endif %}
                </div>
                <nav aria-label="{{ 'Hauptnavigation'|trans }}">
                    <a href="{{ path('video_index') }}">{{ 'Videos'|trans }}</a>
                    {% if module_enabled('news') %}<a href="{{ path('news_index') }}">{{ 'News'|trans }}</a>{% endif %}
                    {% if module_enabled('series') %}<a href="{{ path('series_index') }}">{{ 'Serien'|trans }}</a>{% endif %}
                    {% if module_enabled('pages') %}<a href="{{ path('page_index') }}">{{ 'Seiten'|trans }}</a>{% endif %}
                </nav>
                <nav aria-label="{{ 'Mitglieder'|trans }}">
                    <a href="{{ path('public_member_index') }}">{{ 'Mitglieder'|trans }}</a>
                    {% if site_settings().isMemberRegistrationEnabled %}<a href="{{ path('member_register') }}">{{ 'Registrieren'|trans }}</a>{% endif %}
                    {% if module_enabled('contact') %}<a href="{{ path('contact_new') }}">{{ 'Kontakt'|trans }}</a>{% endif %}
                    <a href="{{ path('content_sitemap') }}">{{ 'Sitemap'|trans }}</a>
                </nav>
            </div>
            <p class="portal-copyright">© {{ 'now'|date('Y') }} {{ site_settings().siteName }}</p>
        </footer>
    </div>
{% endblock %}

{% block javascripts %}
    {% if featured_uses_videojs %}
        <script src="{{ asset('third-party/video.js-8.23.4/video.min.js') }}" defer></script>
        <script src="{{ asset('video/videojs-player.js') }}" defer></script>
    {% elseif featured_uses_hls %}
        <script src="{{ asset('third-party/hls.js-1.7.3/hls.min.js') }}" defer></script>
        <script src="{{ asset('video/hls-player.js') }}" defer></script>
    {% endif %}
    {% if featured_quality_sources is not empty %}<script src="{{ asset('video/video-quality-selector.js') }}" defer></script>{% endif %}
{% endblock %}
