{% extends 'base.html.twig' %}

{% block title %}{{ page.title }} · {{ site_settings().siteName }}{% endblock %}
{% block meta_description %}{% if page.metaDescription is not empty %}<meta name="description" content="{{ page.metaDescription }}">{% elseif page.summary is not empty %}<meta name="description" content="{{ page.summary }}">{% else %}{{ parent() }}{% endif %}{% endblock %}
{% block meta_keywords %}{% if page.metaKeywords is not empty %}<meta name="keywords" content="{{ page.metaKeywords }}">{% endif %}{% endblock %}

{% block body %}
    {{ include('partials/public_site_header.html.twig') }}
    <main class="public-main">
        <article class="public-article">
            <p class="eyebrow">{{ 'Information'|trans }}</p>
            <h1>{{ page.title }}</h1>
            {% if page.summary %}<p class="lead">{{ page.summary }}</p>{% endif %}
            <p class="byline">{{ 'Von %author%'|trans({'%author%': page.authorName}) }}</p>
            {% if page.publishedAt %}<time datetime="{{ page.publishedAt|date('c') }}">{{ page.publishedAt|date('d.m.Y') }}</time>{% endif %}
            <div class="article-body">{{ page.body|rich_text }}</div>
        </article>
        <p>{% if module_enabled('pages') %}<a href="{{ path('page_index') }}">{{ 'Zurück zu allen Seiten'|trans }}</a>{% endif %}</p>
    </main>
{% endblock %}
