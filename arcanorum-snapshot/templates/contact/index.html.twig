{% extends 'base.html.twig' %}

{% block title %}{{ 'Kontakt'|trans }} · {{ site_settings().siteName }}{% endblock %}

{% block body %}
    {{ include('partials/public_site_header.html.twig') }}

    <main class="public-main">
        <section class="public-section" aria-labelledby="contact-heading">
            <p class="eyebrow">{{ 'Wir helfen gern'|trans }}</p>
            <h1 id="contact-heading">{{ 'Kontakt'|trans }}</h1>
            <p class="contact-policy-note">{{ 'Deine Nachricht wird zur Bearbeitung in der Verwaltung gespeichert. Bitte sende hier keine sensiblen Daten.'|trans }}</p>

            {% for message in app.flashes('contact_success') %}
                <p class="flash-message is-success" role="status">{{ message|trans }}</p>
            {% endfor %}
            {% for message in app.flashes('contact_error') %}
                <p class="flash-message is-error" role="alert">{{ message|trans }}</p>
            {% endfor %}

            <form class="comment-form" action="{{ path('contact_new') }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('public_contact') }}">
                <div class="comment-honeypot" aria-hidden="true">
                    <label for="contact-website">{{ 'Webseite'|trans }}</label>
                    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off">
                </div>
                <label for="contact-name">{{ 'Name'|trans }}</label>
                <input id="contact-name" name="name" type="text" maxlength="120" required value="{{ values.name }}">
                <label for="contact-email">{{ 'E-Mail-Adresse'|trans }}</label>
                <input id="contact-email" name="email" type="email" maxlength="254" required value="{{ values.email }}">
                <label for="contact-subject">{{ 'Betreff'|trans }}</label>
                <input id="contact-subject" name="subject" type="text" maxlength="160" required value="{{ values.subject }}">
                <label for="contact-body">{{ 'Nachricht'|trans }}</label>
                <textarea id="contact-body" name="body" rows="8" maxlength="5000" required>{{ values.body }}</textarea>
                <button class="button" type="submit">{{ 'Nachricht senden'|trans }}</button>
            </form>
        </section>
    </main>
{% endblock %}
