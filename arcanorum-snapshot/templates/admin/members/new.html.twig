{% extends 'admin/layout.html.twig' %}

{% block admin_title %}{{ 'Mitglied anlegen'|trans }}{% endblock %}
{% block admin_breadcrumb %}<a href="{{ path('admin_member_index') }}">{{ 'Nutzer'|trans }}</a> / {{ 'Mitglied anlegen'|trans }}{% endblock %}

{% block admin_content %}
    <header class="page-heading">
        <div>
            <p class="eyebrow">{{ 'Mitglieder'|trans }}</p>
            <h1 id="seitenueberschrift">{{ 'Mitglied anlegen'|trans }}</h1>
            <p class="muted">{{ 'Das Konto bleibt gesperrt, bis das Mitglied mit seinem einmaligen Einrichtungscode ein Passwort festlegt.'|trans }}</p>
        </div>
        <a class="button button-secondary" href="{{ path('admin_member_index') }}">{{ 'Zurück zur Übersicht'|trans }}</a>
    </header>

    {% if errors is not empty %}
        <div class="flash-message is-error" role="alert">
            <strong>{{ 'Bitte prüfe die Eingaben.'|trans }}</strong>
            <ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
        </div>
    {% endif %}

    <section class="admin-panel" aria-labelledby="member-new-heading">
        <h2 id="member-new-heading">{{ 'Kontodaten'|trans }}</h2>
        <form class="admin-form" method="post" action="{{ path('admin_member_new') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('member_account_new') }}">
            <label>
                <span>{{ 'E-Mail-Adresse'|trans }}</span>
                <input type="email" name="email" value="{{ values.email }}" maxlength="254" autocomplete="email" required>
            </label>
            <label>
                <span>{{ 'Kanalname'|trans }}</span>
                <input name="handle" value="{{ values.handle }}" minlength="3" maxlength="32" pattern="[a-zA-Z0-9][a-zA-Z0-9_-]{2,31}" autocomplete="off" required>
            </label>
            <label>
                <span>{{ 'Anzeigename'|trans }}</span>
                <input name="display_name" value="{{ values.display_name }}" maxlength="80" autocomplete="name" required>
            </label>
            <div class="form-actions">
                <button class="button" type="submit">{{ 'Mitglied anlegen'|trans }}</button>
                <a class="button button-secondary" href="{{ path('admin_member_index') }}">{{ 'Abbrechen'|trans }}</a>
            </div>
        </form>
    </section>
{% endblock %}
