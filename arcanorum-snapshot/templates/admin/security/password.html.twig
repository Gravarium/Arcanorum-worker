{% extends 'admin/layout.html.twig' %}

{% block admin_title %}{{ 'Administratorpasswort ändern'|trans }}{% endblock %}
{% block admin_breadcrumb %}{{ 'Administratorpasswort ändern'|trans }}{% endblock %}

{% block admin_content %}
    <div class="page-heading">
        <div>
            <p class="eyebrow">{{ 'Kontosicherheit'|trans }}</p>
            <h1 id="seitenueberschrift">{{ 'Administratorpasswort ändern'|trans }}</h1>
            <p class="muted">{{ 'Bestätige dein aktuelles Passwort. Nach der Änderung wirst du abgemeldet und musst dich mit deinem neuen Passwort und MFA erneut anmelden.'|trans }}</p>
        </div>
    </div>

    <section class="admin-panel" aria-labelledby="admin-password-heading">
        <header class="panel-heading"><h2 id="admin-password-heading">{{ 'Eigenes Passwort'|trans }}</h2></header>
        {% for error in errors %}<p class="field-error" role="alert">{{ error|trans }}</p>{% endfor %}
        <form method="post" action="{{ path('admin_password_change') }}" class="admin-form">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_password_change') }}">
            <div class="form-field">
                <label for="current_password">{{ 'Aktuelles Passwort'|trans }}</label>
                <input id="current_password" name="current_password" type="password" autocomplete="current-password" maxlength="4096" required>
            </div>
            <div class="form-field">
                <label for="new_password">{{ 'Neues Passwort'|trans }}</label>
                <input id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="16" maxlength="4096" required>
            </div>
            <div class="form-field">
                <label for="password_confirmation">{{ 'Neues Passwort wiederholen'|trans }}</label>
                <input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" minlength="16" maxlength="4096" required>
            </div>
            <div class="form-actions">
                <button class="button button-primary" type="submit">{{ 'Passwort ändern'|trans }}</button>
            </div>
        </form>
        <p class="muted">{{ 'Das Passwort muss mindestens 16 Zeichen lang sein. Nach fünf Änderungsversuchen innerhalb von 15 Minuten ist eine kurze Wartezeit erforderlich.'|trans }}</p>
    </section>
{% endblock %}
