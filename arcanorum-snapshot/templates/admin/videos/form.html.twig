{% extends 'admin/layout.html.twig' %}

{% block admin_title %}{{ is_edit ? ('Video bearbeiten'|trans) : ('Video hinzufügen'|trans) }}{% endblock %}
{% block admin_breadcrumb %}<a href="{{ path('admin_video_index') }}">{{ 'Videos'|trans }}</a> / {{ is_edit ? ('Bearbeiten'|trans) : ('Hinzufügen'|trans) }}{% endblock %}

{% block admin_content %}
    <div class="page-heading">
        <div>
            <p class="eyebrow">{{ 'Videokatalog'|trans }}</p>
            <h1 id="seitenueberschrift">{{ is_edit ? ('Video bearbeiten'|trans) : ('Video hinzufügen'|trans) }}</h1>
            <p class="muted">{{ 'Geprüfte HTTPS-Quelle oder private Medien-Datei mit Metadaten speichern.'|trans }}</p>
        </div>
        <a class="button button-secondary" href="{{ path('admin_video_index') }}">{{ 'Zurück zur Übersicht'|trans }}</a>
    </div>

    {% if errors is not empty %}
        <div class="flash-message is-error" role="alert">
            <strong>{{ 'Bitte prüfe die Eingaben.'|trans }}</strong>
            <ul>
                {% for error in errors %}<li>{{ error|trans }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}

    <section class="admin-panel" aria-labelledby="video-form-heading">
        <header class="panel-heading">
            <div>
                <h2 id="video-form-heading">{{ 'Videodaten'|trans }}</h2>
                <p class="muted">{{ 'Dateien werden außerhalb des öffentlichen Webpfads gespeichert; MP4, WebM, Ogg und MP3 bis 32 MiB sind zugelassen.'|trans }}</p>
            </div>
        </header>

        <form class="admin-form" method="post" enctype="multipart/form-data" data-video-source-metadata data-video-edit="{{ is_edit ? '1' : '0' }}" data-provider-url-label="{{ 'YouTube- oder Videoanbieter-URL'|trans }}" data-direct-url-label="{{ 'Direkte Medien-URL'|trans }}" data-stream-url-label="{{ 'Stream-URL'|trans }}" data-metadata-endpoint="{{ path('admin_video_metadata') }}" data-metadata-csrf-token="{{ csrf_token('admin_video_metadata') }}" data-metadata-error="{{ 'Provider-Metadaten konnten nicht abgerufen werden.'|trans }}" data-metadata-loaded="{{ 'Provider-Daten und Vorschaubildadresse wurden übernommen.'|trans }}" data-metadata-loading="{{ 'Provider-Metadaten werden abgerufen.'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_video_save') }}">
            <input type="hidden" name="category_ids_present" value="1">
            <input type="hidden" name="embedding_enabled_present" value="1">

            <div class="video-editor-layout">
                <div class="video-editor-main">
                    <section class="video-editor-section" aria-labelledby="video-source-heading" data-video-form-section="source">
                        <h3 id="video-source-heading">{{ 'Videoquelle'|trans }}</h3>
                        <label>
                            <span>{{ 'Quelltyp'|trans }}</span>
                            <select name="source_type" data-video-source-type>
                                <option value="embed" {{ values.source_type == 'embed' ? 'selected' : '' }}>{{ 'Video von Anbieter-URL (YouTube, Vimeo und weitere)'|trans }}</option>
                                <option value="url" {{ values.source_type == 'url' ? 'selected' : '' }}>{{ 'Direkte Video- oder Audio-URL'|trans }}</option>
                                <option value="stream" {{ values.source_type == 'stream' ? 'selected' : '' }}>{{ 'Video- oder Audiostream'|trans }}</option>
                                <option value="file" {{ values.source_type == 'file' ? 'selected' : '' }}>{{ 'Videodatei hochladen'|trans }}</option>
                            </select>
                        </label>
                        <div class="video-source-url-field" data-video-source-url-field>
                            <label>
                                <span data-video-source-url-label>{{ 'YouTube- oder Videoanbieter-URL'|trans }}</span>
                                <input type="url" name="source_url" value="{{ values.source_url }}" maxlength="2048" placeholder="https://www.youtube.com/watch?v=…" data-video-source-url>
                            </label>
                            <div class="video-metadata-actions">
                                <button class="button button-secondary" type="button" data-video-metadata-fetch>{{ 'Titel, Beschreibung, Laufzeit und Vorschaubild übernehmen'|trans }}</button>
                                <p class="muted" data-video-metadata-status role="status" aria-live="polite"></p>
                            </div>
                            <small>{{ 'Füge einen YouTube-, Vimeo- oder anderen unterstützten Videolink ein. Wenn verfügbar, werden Titel, Beschreibung, Laufzeit und Vorschaubildadresse aus den Anbieterdaten übernommen.'|trans }} {{ 'Falls der Anbieterabruf nicht eingerichtet ist, trage die Videodaten manuell ein; den geprüften Link kannst du trotzdem speichern.'|trans }}</small>
                            <small data-video-source-help="embed">{{ 'Für Einbettungen sind nur geprüfte YouTube-, Vimeo-, Dailymotion-, Facebook-, Google-Drive-, Rutube-, VK- und Youku-Video-URLs zugelassen; fremder HTML-Code wird nicht ausgeführt.'|trans }}</small>
                            <small data-video-source-help="url">{{ 'Direkte Medien-URLs müssen auf eine unterstützte Mediendatei zeigen. Der Server ruft die Adresse nicht ab.'|trans }}</small>
                            <small data-video-source-help="stream">{{ 'Unterstützt werden direkte MP4-, M4V-, WebM-, Ogg- und MP3-Dateien sowie HLS-Live-Playlists (M3U8) auf ausdrücklich freigegebenen HTTPS-Hosts. HLS-Segmente und Schlüssel müssen ebenfalls freigegeben sein.'|trans }}</small>
                            <small>{{ 'Die vollständige Adresse einschließlich Abfrageparametern wird öffentlich ausgegeben. Bitte keine Zugangsdaten oder geheimen Tokens verwenden.'|trans }}</small>
                            {% if not stream_configured %}<small data-video-source-help="stream">{{ 'Streamhosts sind derzeit nicht freigegeben; bitte die Hostingverwaltung um Einrichtung bitten.'|trans }}</small>{% endif %}
                        </div>
                        <label data-video-source-file-field>
                            <span>{{ 'Video- oder MP3-Datei'|trans }}</span>
                            <input type="file" name="video_file" accept="video/mp4,video/webm,video/ogg,audio/mpeg,.mp3" data-video-source-file>
                            <small>{{ 'Bei Quellart „Private Medien-Datei“ erforderlich; beim Bearbeiten optional, wenn die vorhandene Datei bleiben soll.'|trans }}</small>
                            {% if current_media_type %}<small>{{ 'Aktuelle private Datei: %media_type%.'|trans({'%media_type%': current_media_type}) }}</small>{% endif %}
                        </label>
                    </section>

                    <section class="video-editor-section" data-video-form-section="title">
                        <h3>{{ 'Titel und Beschreibung'|trans }}</h3>
                        <label>
                            <span>{{ 'Titel'|trans }}</span>
                            <input name="title" value="{{ values.title }}" maxlength="180" required>
                        </label>
                        <label>
                            <span>{{ 'Permalink'|trans }}</span>
                            <input name="slug" value="{{ values.slug }}" maxlength="200" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" aria-describedby="video-slug-help">
                            <small id="video-slug-help">{{ 'Kleinbuchstaben, Ziffern und Bindestriche. Leer lassen, um den Permalink aus dem Titel zu bilden.'|trans }}</small>
                            {% if is_edit %}<small>{{ 'Öffentliche Adresse'|trans }}: <a href="{{ path('video_show_slug', {id: values.slug}) }}">{{ absolute_url(path('video_show_slug', {id: values.slug})) }}</a></small>{% endif %}
                        </label>
                        <label>
                            <span>{{ 'Beschreibung'|trans }}</span>
                            <textarea name="description" rows="8" maxlength="100000">{{ values.description }}</textarea>
                        </label>
                    </section>

                    <section class="video-editor-section" data-video-form-section="details">
                        <h3>{{ 'Video-Details'|trans }}</h3>
                        <fieldset class="video-duration-field">
                            <legend>{{ 'Medienlaufzeit'|trans }}</legend>
                            <div class="form-grid">
                                <label><span>{{ 'Minuten'|trans }}</span><input type="number" name="duration_minutes" value="{{ values.duration_minutes }}" min="0" max="35791394" step="1" inputmode="numeric"></label>
                                <label><span>{{ 'Sekunden'|trans }}</span><input type="number" name="duration_seconds_part" value="{{ values.duration_seconds_part }}" min="0" max="59" step="1" inputmode="numeric"></label>
                            </div>
                            <small>{{ 'Optional. Sekunden müssen zwischen 0 und 59 liegen.'|trans }}</small>
                        </fieldset>
                        <label>
                            <span>{{ 'Schlagwörter'|trans }}</span>
                            <input name="tags" value="{{ values.tags }}" maxlength="1000" placeholder="{{ 'z. B. Kultur, Interviews, Neuigkeiten'|trans }}">
                            <small>{{ 'Bis zu zehn Schlagwörter, getrennt durch Komma oder Zeilenumbruch.'|trans }}</small>
                        </label>
                        <label>
                            <span>{{ 'Videosprache'|trans }}</span>
                            <input name="language_code" value="{{ values.language_code }}" maxlength="35" pattern="[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*" list="video-language-codes" placeholder="de" autocomplete="off">
                            <datalist id="video-language-codes">
                                <option value="de">Deutsch</option><option value="en">English</option><option value="ar">العربية</option>
                                <option value="es">Español</option><option value="fr">Français</option><option value="it">Italiano</option>
                                <option value="ja">日本語</option><option value="ko">한국어</option><option value="nl">Nederlands</option>
                                <option value="pl">Polski</option><option value="pt">Português</option><option value="ru">Русский</option>
                                <option value="tr">Türkçe</option><option value="zh">中文</option>
                            </datalist>
                            <small>{{ 'Optionaler Sprachcode nach BCP 47, zum Beispiel de, en-US oder ar.'|trans }}</small>
                        </label>
                        {{ include('admin/partials/custom_fields_editor.html.twig', {custom_fields: values.custom_fields, field_id_prefix: 'video-custom-field'}) }}
                    </section>
                </div>

                <aside class="video-editor-sidebar">
                    <section class="video-editor-section">
                        <h3>{{ 'Veröffentlichung'|trans }}</h3>
                        <fieldset class="video-category-options" data-testid="video-category-selection" aria-describedby="video-category-help">
                            <legend>{{ 'Videokategorien'|trans }}</legend>
                            <div class="video-category-checkboxes">
                                {% for category in categories %}
                                    <label>
                                        <input type="checkbox" name="category_ids[]" value="{{ category.id }}" {{ category.id in values.category_ids ? 'checked' : '' }}>
                                        <span>{{ category.name }}</span>
                                    </label>
                                {% else %}
                                    <p class="muted">{{ 'Noch keine Videokategorien vorhanden.'|trans }}</p>
                                {% endfor %}
                            </div>
                        </fieldset>
                        <small id="video-category-help" class="video-category-help">{{ 'Wähle eine oder mehrere Kategorien aus.'|trans }}</small>
                        <p class="video-category-manage"><a href="{{ path('admin_category_index', {type: 'video'}) }}">{{ 'Videokategorien verwalten'|trans }}</a></p>
                        <div class="video-category-quick-add" data-testid="video-category-quick-add">
                            <label>
                                <span>{{ 'Neue Videokategorie'|trans }}</span>
                                <input name="new_category_name" value="{{ values.new_category_name }}" maxlength="100" autocomplete="off">
                            </label>
                            <label>
                                <span>{{ 'Kategorien-Permalink'|trans }}</span>
                                <input name="new_category_slug" value="{{ values.new_category_slug }}" maxlength="120" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" autocomplete="off">
                                <small>{{ 'Optional. Leer lassen, um den Permalink aus dem Kategorienamen zu bilden.'|trans }}</small>
                            </label>
                            <p class="muted">{{ 'Die neue Kategorie wird beim Speichern angelegt und diesem Video zugeordnet.'|trans }}</p>
                        </div>
                        <label>
                            <span>{{ 'Status'|trans }}</span>
                            <select name="status">
                                <option value="draft" {{ values.status == 'draft' ? 'selected' : '' }}>{{ 'Entwurf'|trans }}</option>
                                <option value="published" {{ values.status == 'published' ? 'selected' : '' }}>{{ 'Veröffentlicht oder geplant'|trans }}</option>
                            </select>
                        </label>
                        <label>
                            <span>{{ 'Veröffentlichen am'|trans }}</span>
                            <input type="datetime-local" name="publish_at" value="{{ values.publish_at }}">
                            <small>{{ 'Veröffentlichungszeit in der eingestellten Website-Zeitzone. Ein Zeitpunkt in der Zukunft plant die Veröffentlichung.'|trans }}</small>
                        </label>
                        <label>
                            <span>{{ 'Eingereicht von'|trans }}</span>
                            <input name="author_name" value="{{ values.author_name }}" maxlength="120" required>
                        </label>
                        <label data-testid="video-view-count">
                            <span>{{ 'Aufrufe'|trans }}</span>
                            <input type="number" name="view_count" value="{{ values.view_count }}" min="0" max="2147483647" step="1" inputmode="numeric" required>
                        </label>
                    </section>

                    {% if not is_edit %}
                        <section class="video-editor-section" aria-labelledby="video-thumbnail-new-heading">
                            <h3 id="video-thumbnail-new-heading">{{ 'Vorschaubild'|trans }}</h3>
                            <label>
                                <span>{{ 'Vorschaubild-Adresse'|trans }}</span>
                                <input type="url" name="thumbnail_url" value="{{ values.thumbnail_url }}" maxlength="2048" inputmode="url" autocomplete="url" placeholder="https://example.org/vorschaubild.jpg" pattern="https://.*">
                                <small>{{ 'Die Adresse kann automatisch aus dem Anbietereintrag übernommen oder manuell eingetragen werden. Beim Speichern wird das Bild geprüft und privat gespeichert; Besucher laden es anschließend von dieser Website.'|trans }}</small>
                            </label>
                            <label>
                                <span>{{ 'Bilddatei'|trans }}</span>
                                <input type="file" name="thumbnail_file" accept="image/jpeg,image/png,image/webp">
                                <small>{{ 'Alternativ eine Bilddatei auswählen: JPEG, PNG oder WebP bis 4 MiB. SVG-Dateien sind nicht zugelassen; die Bilddatei bleibt außerhalb des öffentlichen Webpfads.'|trans }}</small>
                            </label>
                        </section>
                    {% endif %}

                    <section class="video-editor-section">
                        <h3>{{ 'Zugriff und Wiedergabe'|trans }}</h3>
                        <fieldset class="video-visibility-options" data-testid="video-visibility">
                            <legend>{{ 'Sichtbarkeit'|trans }}</legend>
                            <div class="video-visibility-choices">
                                <label><input type="radio" name="members_only" value="0" required {{ not values.members_only ? 'checked' : '' }}> {{ 'Öffentlich'|trans }}</label>
                                <label><input type="radio" name="members_only" value="1" required {{ values.members_only ? 'checked' : '' }}> {{ 'Nur registrierte Mitglieder'|trans }}</label>
                            </div>
                        </fieldset>
                        <div class="form-checks">
                            <label><input type="checkbox" name="featured" value="1" {{ values.featured ? 'checked' : '' }}> {{ 'Auf der Startseite hervorheben'|trans }}</label>
                            <label><input type="checkbox" name="comments_enabled" value="1" {{ values.comments_enabled ? 'checked' : '' }}> {{ 'Kommentare erlauben'|trans }}</label>
                            <label><input type="checkbox" name="embedding_enabled" value="1" {{ values.embedding_enabled ? 'checked' : '' }}> {{ 'Einbettung auf anderen Websites erlauben'|trans }}</label>
                        </div>
                        <label>
                            <span>{{ 'Erlaubte Einbettungsseiten'|trans }}</span>
                            <textarea name="embed_origins" rows="4" maxlength="4000" placeholder="https://example.org&#10;https://video.example.net">{{ values.embed_origins }}</textarea>
                            <small>{{ 'Ein HTTPS-Ursprung pro Zeile, ohne Pfad. Zum Deaktivieren die Liste leeren. Nur Administratoren können diese Freigabe ändern; Entwürfe und Mitgliedervideos werden nicht extern ausgegeben.'|trans }}</small>
                        </label>
                    </section>
                </aside>
            </div>

            <div class="form-actions">
                <button class="button" type="submit">{{ is_edit ? ('Änderungen speichern'|trans) : ('Video speichern'|trans) }}</button>
                <a class="button button-secondary" href="{{ path('admin_video_index') }}">{{ 'Abbrechen'|trans }}</a>
            </div>
        </form>
    </section>

    {% if embed_code %}
        <section class="admin-panel" aria-labelledby="video-embed-code-heading">
            <header class="panel-heading">
                <div>
                    <h2 id="video-embed-code-heading">{{ 'Einbettungscode'|trans }}</h2>
                    <p class="muted">{{ 'Der Player funktioniert nur auf den oben freigegebenen HTTPS-Ursprüngen.'|trans }}</p>
                </div>
            </header>
            <label>
                <span>{{ 'HTML-Code zum Kopieren'|trans }}</span>
                <textarea data-testid="video-embed-code" rows="4" readonly>{{ embed_code }}</textarea>
            </label>
        </section>
    {% endif %}

    {% if is_edit %}
        <section class="admin-panel" aria-labelledby="video-thumbnail-heading">
            <header class="panel-heading">
                <div>
                    <h2 id="video-thumbnail-heading">{{ 'Vorschaubild'|trans }}</h2>
                    <p class="muted">{{ 'JPEG, PNG oder WebP bis 4 MiB. SVG-Dateien sind nicht zugelassen; die Bilddatei bleibt außerhalb des öffentlichen Webpfads.'|trans }}</p>
                </div>
            </header>

            {% if has_thumbnail %}
                <img class="video-thumbnail video-thumbnail-admin" src="{{ path('admin_video_thumbnail_preview', {id: video_id}) }}" alt="{{ 'Aktuelles Vorschaubild für %title%'|trans({'%title%': values.title}) }}">
            {% endif %}

            <form class="admin-form" method="post" enctype="multipart/form-data" action="{{ path('admin_video_thumbnail_manage', {id: video_id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_video_thumbnail_' ~ video_id) }}">
                <input type="hidden" name="action" value="upload">
                <label>
                    <span>{{ 'Bilddatei'|trans }}</span>
                    <input type="file" name="thumbnail_file" accept="image/jpeg,image/png,image/webp" required>
                </label>
                <div class="form-actions">
                    <button class="button" type="submit">{{ 'Vorschaubild hochladen'|trans }}</button>
                </div>
            </form>

            <form class="admin-form" method="post" action="{{ path('admin_video_thumbnail_import_url', {id: video_id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_video_thumbnail_url_import_' ~ video_id) }}">
                <input type="hidden" name="action" value="import_url">
                <label>
                    <span>{{ 'Vorschaubild-Adresse'|trans }}</span>
                    <input type="url" name="thumbnail_url" maxlength="2048" inputmode="url" autocomplete="url" placeholder="https://example.org/vorschaubild.jpg" pattern="https://.*" required>
                    <small>{{ 'Die öffentliche HTTPS-Bildadresse wird geprüft, als Bilddatei heruntergeladen und privat gespeichert. Besucher laden das Bild anschließend von dieser Website.'|trans }}</small>
                </label>
                <div class="form-actions">
                    <button class="button button-secondary" type="submit">{{ 'Vorschaubild aus URL übernehmen'|trans }}</button>
                </div>
            </form>

            {% if values.source_type in ['embed', 'url'] and values.source_url != '' %}
                <form method="post" action="{{ path('admin_video_thumbnail_provider_import', {id: video_id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_video_thumbnail_provider_import_' ~ video_id) }}">
                    <input type="hidden" name="action" value="provider_import">
                    <p class="muted">{{ 'Das Vorschaubild wird über die feste Provider-API ausgewählt, sicher geprüft und privat gespeichert.'|trans }}</p>
                    <button class="button button-secondary" type="submit">{{ 'Provider-Vorschaubild übernehmen'|trans }}</button>
                </form>
            {% endif %}

            {% if has_thumbnail %}
                <form method="post" action="{{ path('admin_video_thumbnail_manage', {id: video_id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_video_thumbnail_' ~ video_id) }}">
                    <input type="hidden" name="action" value="remove">
                    <div class="form-actions">
                        <button class="button button-secondary" type="submit">{{ 'Vorschaubild entfernen'|trans }}</button>
                    </div>
                </form>
            {% endif %}
        </section>

        <section class="admin-panel" aria-labelledby="video-subtitle-heading">
            <header class="panel-heading">
                <div>
                    <h2 id="video-subtitle-heading">{{ 'Untertitel und Sprachspuren'|trans }}</h2>
                    <p class="muted">{{ 'Nur geprüfte WebVTT-Dateien bis 1 MiB werden außerhalb des öffentlichen Webpfads gespeichert. Jede Sprache erhält eine eigene auswählbare Spur.'|trans }}</p>
                </div>
            </header>

            {% if subtitle_supported %}
                <form class="admin-form" method="post" enctype="multipart/form-data" action="{{ path('admin_video_subtitle_upload', {id: video_id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_video_subtitles_upload_' ~ video_id) }}">
                    <label>
                        <span>{{ 'Sprachcode (z. B. de oder en-US)'|trans }}</span>
                        <input name="language_code" maxlength="35" pattern="[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*" autocomplete="off" required>
                    </label>
                    <label>
                        <span>{{ 'Beschriftung im Player'|trans }}</span>
                        <input name="label" maxlength="120" required>
                    </label>
                    <label>
                        <span>{{ 'WebVTT-Datei'|trans }}</span>
                        <input type="file" name="subtitle_file" accept=".vtt,text/vtt,text/plain" required>
                    </label>
                    <div class="form-actions">
                        <button class="button" type="submit">{{ 'Untertitel speichern oder aktualisieren'|trans }}</button>
                    </div>
                </form>
            {% else %}
                <p>{{ 'Untertitelspuren können für private Medien-Dateien und geprüfte Video- oder Audiostreams hochgeladen werden.'|trans }}</p>
            {% endif %}

            {% if subtitle_tracks is not empty %}
                <div class="table-wrap">
                    <table class="admin-table">
                        <caption class="visually-hidden">{{ 'Untertitel und Sprachspuren'|trans }}</caption>
                        <thead><tr><th>{{ 'Sprache'|trans }}</th><th>{{ 'Beschriftung'|trans }}</th><th>{{ 'Dateigröße'|trans }}</th><th>{{ 'Aktionen'|trans }}</th></tr></thead>
                        <tbody>
                            {% for subtitle in subtitle_tracks %}
                                <tr>
                                    <td><code>{{ subtitle.languageCode }}</code></td>
                                    <td>{{ subtitle.label }}</td>
                                    <td>{{ '%size% Byte'|trans({'%size%': subtitle.size}) }}</td>
                                    <td>
                                        <form method="post" action="{{ path('admin_video_subtitle_delete', {id: video_id, trackId: subtitle.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_video_subtitles_delete_' ~ subtitle.id) }}">
                                            <input type="hidden" name="action" value="delete">
                                            <button class="button button-secondary" type="submit">{{ 'Untertitelspur entfernen'|trans }}</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p>{{ 'Für dieses Video sind noch keine Untertitelspuren gespeichert.'|trans }}</p>
            {% endif %}
        </section>

        <section class="admin-panel" aria-labelledby="video-quality-heading">
            <header class="panel-heading">
                <div>
                    <h2 id="video-quality-heading">{{ 'Videoqualitätsquellen'|trans }}</h2>
                    <p class="muted">{{ 'Ergänze freigegebene MP4-, WebM- oder Ogg-Streamadressen mit fester Qualitätsstufe. Der Server ruft die Adressen nicht ab.'|trans }}</p>
                </div>
            </header>

            {% if quality_source_supported and stream_configured %}
                <form class="admin-form" method="post" action="{{ path('admin_video_quality_source_save', {id: video_id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_video_quality_source_save_' ~ video_id) }}">
                    <label>
                        <span>{{ 'Qualitätsstufe'|trans }}</span>
                        <select name="resolution" required>
                            {% for quality_option in quality_options %}
                                <option value="{{ quality_option.value }}">{{ quality_option.value }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label>
                        <span>{{ 'Freigegebene HTTPS-Medienadresse'|trans }}</span>
                        <input type="url" name="source_url" maxlength="2048" inputmode="url" autocomplete="off" pattern="https://.*" required>
                    </label>
                    <div class="form-actions">
                        <button class="button" type="submit">{{ 'Qualitätsquelle speichern'|trans }}</button>
                    </div>
                </form>
            {% elseif quality_source_supported %}
                <p>{{ 'Qualitätsquellen können erst verwendet werden, wenn mindestens ein sicherer Medienhost eingerichtet ist.'|trans }}</p>
            {% else %}
                <p>{{ 'Qualitätsquellen sind nur für Videodateien und geprüfte Streams verfügbar.'|trans }}</p>
            {% endif %}

            {% if quality_sources is not empty %}
                <div class="table-wrap">
                    <table class="admin-table">
                        <caption class="visually-hidden">{{ 'Videoqualitätsquellen'|trans }}</caption>
                        <thead><tr><th>{{ 'Qualitätsstufe'|trans }}</th><th>{{ 'Medienhost'|trans }}</th><th>{{ 'Aktionen'|trans }}</th></tr></thead>
                        <tbody>
                            {% for quality_source in quality_sources %}
                                <tr>
                                    <td><code>{{ quality_source.resolution.value }}</code></td>
                                    <td><code>{{ quality_source.sourceUrl|split('/')[2] ?? '' }}</code></td>
                                    <td>
                                        <form method="post" action="{{ path('admin_video_quality_source_delete', {id: video_id, sourceId: quality_source.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin_video_quality_source_delete_' ~ quality_source.id) }}">
                                            <input type="hidden" name="action" value="delete">
                                            <button class="button button-secondary" type="submit">{{ 'Qualitätsquelle entfernen'|trans }}</button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p>{{ 'Für dieses Video sind noch keine zusätzlichen Qualitätsquellen gespeichert.'|trans }}</p>
            {% endif %}
        </section>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('admin/video-source-metadata.js') }}" defer></script>
{% endblock %}
