{% extends 'admin/layout.html.twig' %}

{% block admin_title %}{{ 'Video und Wiedergabe'|trans }}{% endblock %}
{% block admin_breadcrumb %}{{ 'Video und Wiedergabe'|trans }}{% endblock %}

{% block admin_content %}
    <div class="page-heading">
        <div>
            <p class="eyebrow">{{ 'Einstellungen · Inhalte'|trans }}</p>
            <h1 id="seitenueberschrift">{{ 'Video und Wiedergabe'|trans }}</h1>
            <p class="muted">{{ 'Player-Vorgaben für neue und öffentliche Inhalte. Gespeicherte Inhalte und Warteschlangen bleiben beim Abschalten erhalten.'|trans }}</p>
        </div>
    </div>

    {% if errors.form is defined %}<p class="field-error" role="alert">{{ errors.form|trans }}</p>{% endif %}
    {% for field, message in errors %}{% if field != 'form' %}<p id="{{ field }}-error" class="field-error" role="alert">{{ message|trans }}</p>{% endif %}{% endfor %}

    <section class="admin-panel" aria-labelledby="player-options-heading">
        <header class="panel-heading"><h2 id="player-options-heading">{{ 'Player'|trans }}</h2></header>
        <form method="post" action="{{ path('admin_content_settings_update') }}" class="admin-form">
            <input type="hidden" name="token" value="{{ csrf_token('admin_content_settings') }}">
            <label>
                <span>{{ 'Player für lokale Medien'|trans }}</span>
                <select name="video_player_engine" required>
                    <option value="native"{% if form.video_player_engine == 'native' %} selected{% endif %}>{{ 'Native HTML5-Steuerung'|trans }}</option>
                    <option value="videojs"{% if form.video_player_engine == 'videojs' %} selected{% endif %}>{{ 'Video.js-Steuerung'|trans }}</option>
                </select>
            </label>
            <label>
                <span>{{ 'Medien vorladen'|trans }}</span>
                <select name="video_preload_mode" required>
                    <option value="none"{% if form.video_preload_mode == 'none' %} selected{% endif %}>{{ 'Nicht vorladen'|trans }}</option>
                    <option value="metadata"{% if form.video_preload_mode == 'metadata' %} selected{% endif %}>{{ 'Nur Metadaten vorladen'|trans }}</option>
                    <option value="auto"{% if form.video_preload_mode == 'auto' %} selected{% endif %}>{{ 'Medien nach Browserentscheidung vorladen'|trans }}</option>
                </select>
            </label>
            <label>
                <span>{{ 'Seitenverhältnis des Players'|trans }}</span>
                <select name="video_player_aspect_ratio" required>
                    <option value="16:9"{% if form.video_player_aspect_ratio == '16:9' %} selected{% endif %}>16:9</option>
                    <option value="4:3"{% if form.video_player_aspect_ratio == '4:3' %} selected{% endif %}>4:3</option>
                    <option value="1:1"{% if form.video_player_aspect_ratio == '1:1' %} selected{% endif %}>1:1</option>
                    <option value="9:16"{% if form.video_player_aspect_ratio == '9:16' %} selected{% endif %}>9:16</option>
                </select>
            </label>
            <label>
                <span>{{ 'Maximale Playerbreite'|trans }}</span>
                <select name="video_player_max_width" required>
                    <option value="fluid"{% if form.video_player_max_width == 'fluid' %} selected{% endif %}>{{ 'Fließend und responsiv'|trans }}</option>
                    <option value="640"{% if form.video_player_max_width == '640' %} selected{% endif %}>640 px</option>
                    <option value="800"{% if form.video_player_max_width == '800' %} selected{% endif %}>800 px</option>
                    <option value="1024"{% if form.video_player_max_width == '1024' %} selected{% endif %}>1024 px</option>
                </select>
            </label>
            <label>
                <span>{{ 'Maximale Playerbreite für Einbettungen'|trans }}</span>
                <select name="video_player_embed_max_width" required>
                    <option value="fluid"{% if form.video_player_embed_max_width == 'fluid' %} selected{% endif %}>{{ 'Fließend und responsiv'|trans }}</option>
                    <option value="640"{% if form.video_player_embed_max_width == '640' %} selected{% endif %}>640 px</option>
                    <option value="800"{% if form.video_player_embed_max_width == '800' %} selected{% endif %}>800 px</option>
                    <option value="1024"{% if form.video_player_embed_max_width == '1024' %} selected{% endif %}>1024 px</option>
                </select>
            </label>
            <label>
                <span>{{ 'Maximale Playerbreite auf der Startseite'|trans }}</span>
                <select name="video_player_home_max_width" required>
                    <option value="fluid"{% if form.video_player_home_max_width == 'fluid' %} selected{% endif %}>{{ 'Fließend und responsiv'|trans }}</option>
                    <option value="640"{% if form.video_player_home_max_width == '640' %} selected{% endif %}>640 px</option>
                    <option value="800"{% if form.video_player_home_max_width == '800' %} selected{% endif %}>800 px</option>
                    <option value="1024"{% if form.video_player_home_max_width == '1024' %} selected{% endif %}>1024 px</option>
                </select>
            </label>
            <label>
                <span>{{ 'Player-Farbschema'|trans }}</span>
                <select name="video_player_color_scheme" required>
                    <option value="midnight"{% if form.video_player_color_scheme == 'midnight' %} selected{% endif %}>{{ 'Mitternacht'|trans }}</option>
                    <option value="ocean"{% if form.video_player_color_scheme == 'ocean' %} selected{% endif %}>{{ 'Ozean'|trans }}</option>
                    <option value="forest"{% if form.video_player_color_scheme == 'forest' %} selected{% endif %}>{{ 'Wald'|trans }}</option>
                    <option value="ember"{% if form.video_player_color_scheme == 'ember' %} selected{% endif %}>{{ 'Glut'|trans }}</option>
                </select>
            </label>
            <label>
                <span>{{ 'Auflösung importierter Provider-Vorschaubilder'|trans }}</span>
                <select name="provider_thumbnail_resolution" required>
                    <option value="small"{% if form.provider_thumbnail_resolution == 'small' %} selected{% endif %}>{{ 'Klein (bis etwa 320 px)'|trans }}</option>
                    <option value="medium"{% if form.provider_thumbnail_resolution == 'medium' %} selected{% endif %}>{{ 'Mittel (bis etwa 640 px)'|trans }}</option>
                    <option value="large"{% if form.provider_thumbnail_resolution == 'large' %} selected{% endif %}>{{ 'Groß (bis etwa 1280 px)'|trans }}</option>
                    <option value="extra-large"{% if form.provider_thumbnail_resolution == 'extra-large' %} selected{% endif %}>{{ 'Extra groß (bis etwa 1920 px)'|trans }}</option>
                    <option value="original"{% if form.provider_thumbnail_resolution == 'original' %} selected{% endif %}>{{ 'Größte verfügbare Auflösung'|trans }}</option>
                </select>
            </label>
            <input type="hidden" name="video_player_watermark_enabled" value="0">
            <label><input type="checkbox" name="video_player_watermark_enabled" value="1"{% if form.video_player_watermark_enabled == '1' %} checked{% endif %}> {{ 'Arcanorum-Wasserzeichen im eigenen Player anzeigen'|trans }}</label>
            <input type="hidden" name="player_autoplay_enabled" value="0">
            <label><input type="checkbox" name="player_autoplay_enabled" value="1"{% if form.player_autoplay_enabled == '1' %} checked{% endif %}> {{ 'Player automatisch starten'|trans }}</label>
            <input type="hidden" name="player_autoplay_muted" value="0">
            <label><input type="checkbox" name="player_autoplay_muted" value="1"{% if form.player_autoplay_muted == '1' %} checked{% endif %}> {{ 'Automatische Wiedergabe stummschalten'|trans }}</label>
            <input type="hidden" name="player_featured_autoplay_enabled" value="0">
            <label><input type="checkbox" name="player_featured_autoplay_enabled" value="1"{% if form.player_featured_autoplay_enabled == '1' %} checked{% endif %}> {{ 'Hervorgehobenes Video auf der Startseite automatisch und stumm starten'|trans }}</label>
            <label>
                <span>{{ 'Schwelle für automatische Video-Hervorhebung'|trans }}</span>
                <input type="number" name="auto_feature_view_threshold" min="0" max="2147483647" step="1" inputmode="numeric" required aria-describedby="auto-feature-view-threshold-help{% if errors.auto_feature_view_threshold is defined %} auto_feature_view_threshold-error{% endif %}"{% if errors.auto_feature_view_threshold is defined %} aria-invalid="true"{% endif %} value="{{ form.auto_feature_view_threshold }}">
            </label>
            <p id="auto-feature-view-threshold-help" class="muted">{{ 'Gezählte öffentliche Aufrufe bis zur einmaligen Hervorhebung; 0 deaktiviert die automatische Hervorhebung.'|trans }}</p>
            <input type="hidden" name="default_comments_enabled" value="{{ form.default_comments_enabled }}">
            <input type="hidden" name="guest_comments_enabled" value="{{ form.guest_comments_enabled }}">
            <input type="hidden" name="public_video_submissions_enabled" value="{{ form.public_video_submissions_enabled }}">
            <input type="hidden" name="public_video_embedding_enabled" value="{{ form.public_video_embedding_enabled }}">
            <p class="muted">{{ 'Die Auswahl gilt für lokale Dateien und geprüfte Streams. Externe Anbieter-Einbettungen verwenden weiterhin den Player des Anbieters. Video.js wird lokal bereitgestellt.'|trans }}</p>
            <p class="muted">{{ 'Die Vorladeeinstellung ist ein Hinweis an den Browser. Die Option für Medien kann mehr Daten übertragen, bevor die Wiedergabe beginnt.'|trans }}</p>
            <p class="muted">{{ 'Automatische Wiedergabe mit Ton wird abgewiesen. Geprüfte Videoeinbettungen externer Anbieter werden von dieser Player-Vorgabe nicht verändert.'|trans }}</p>
            <p class="muted">{{ 'Die Einbettungsbreite begrenzt den kopierbaren Playercode responsiv auf die gewählte Maximalbreite.'|trans }}</p>
            <p class="muted">{{ 'Der hervorgehobene Startseitenplayer verwendet seine eigene Breite. Autoplay gilt nur für lokale Dateien und freigegebene Streams und startet immer stumm.'|trans }}</p>
            <p class="muted">{{ 'Das Wasserzeichen verwendet den Website-Namen und führt zurück zur Startseite. Die Farbauswahl gilt nur für den Arcanorum-Player.'|trans }}</p>
            <p class="muted">{{ 'Provider-Vorschaubilder werden beim Import geprüft und privat gespeichert. Besucher laden sie anschließend nur von dieser Website.'|trans }}</p>
            <div class="form-actions"><button class="button button-primary" type="submit">{{ 'Player-Einstellungen speichern'|trans }}</button></div>
        </form>
        <div class="admin-form">
            <h3>{{ 'Wasserzeichenbild'|trans }}</h3>
            {% if settings.videoPlayerWatermarkSha256 is not null %}
                <img class="player-watermark-preview" src="{{ path('admin_content_settings_watermark_preview', {sha256: settings.videoPlayerWatermarkSha256}) }}" alt="{{ 'Gespeichertes Player-Wasserzeichen'|trans }}" decoding="async">
            {% endif %}
            <form method="post" action="{{ path('admin_content_watermark_upload') }}" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_player_watermark') }}">
                <label for="watermark_file">{{ 'JPEG-, PNG- oder WebP-Datei (maximal 2 MiB)'|trans }}</label>
                <input id="watermark_file" name="watermark_file" type="file" accept="image/jpeg,image/png,image/webp" required>
                <div class="form-actions"><button class="button button-secondary" type="submit">{{ 'Wasserzeichenbild speichern'|trans }}</button></div>
            </form>
            {% if settings.videoPlayerWatermarkObjectId is not null %}
                <form method="post" action="{{ path('admin_content_watermark_remove') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_player_watermark') }}">
                    <button class="button button-secondary" type="submit">{{ 'Wasserzeichenbild entfernen'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </section>

    <section class="admin-panel" aria-labelledby="content-options-heading">
        <header class="panel-heading"><h2 id="content-options-heading">{{ 'Kommentare und Einreichungen'|trans }}</h2></header>
        <form method="post" action="{{ path('admin_content_settings_update') }}" class="admin-form">
            <input type="hidden" name="token" value="{{ csrf_token('admin_content_settings') }}">
            <input type="hidden" name="video_player_engine" value="{{ form.video_player_engine }}">
            <input type="hidden" name="provider_thumbnail_resolution" value="{{ form.provider_thumbnail_resolution }}">
            <input type="hidden" name="video_preload_mode" value="{{ form.video_preload_mode }}">
            <input type="hidden" name="player_autoplay_enabled" value="{{ form.player_autoplay_enabled }}">
            <input type="hidden" name="player_autoplay_muted" value="{{ form.player_autoplay_muted }}">
            <input type="hidden" name="video_player_aspect_ratio" value="{{ form.video_player_aspect_ratio }}">
            <input type="hidden" name="video_player_max_width" value="{{ form.video_player_max_width }}">
            <input type="hidden" name="video_player_embed_max_width" value="{{ form.video_player_embed_max_width }}">
            <input type="hidden" name="video_player_home_max_width" value="{{ form.video_player_home_max_width }}">
            <input type="hidden" name="player_featured_autoplay_enabled" value="{{ form.player_featured_autoplay_enabled }}">
            <input type="hidden" name="auto_feature_view_threshold" value="{{ form.auto_feature_view_threshold }}">
            <input type="hidden" name="video_player_color_scheme" value="{{ form.video_player_color_scheme }}">
            <input type="hidden" name="video_player_watermark_enabled" value="{{ form.video_player_watermark_enabled }}">
            <input type="hidden" name="default_comments_enabled" value="0">
            <label><input type="checkbox" name="default_comments_enabled" value="1"{% if form.default_comments_enabled == '1' %} checked{% endif %}> {{ 'Kommentare bei neuen News und Videos standardmäßig erlauben'|trans }}</label>
            <input type="hidden" name="guest_comments_enabled" value="0">
            <label><input type="checkbox" name="guest_comments_enabled" value="1"{% if form.guest_comments_enabled == '1' %} checked{% endif %}> {{ 'Kommentare von Gästen ohne Mitgliedskonto erlauben'|trans }}</label>
            <label>
                <span>{{ 'Standardreihenfolge der Kommentare'|trans }}</span>
                <select name="comment_default_sort" required>
                    <option value="added"{% if form.comment_default_sort == 'added' %} selected{% endif %}>{{ 'Neueste Kommentare zuerst'|trans }}</option>
                    <option value="score"{% if form.comment_default_sort == 'score' %} selected{% endif %}>{{ 'Am besten bewertete Kommentare zuerst'|trans }}</option>
                </select>
            </label>
            {% if errors.comment_default_sort is defined %}<p class="field-error" role="alert">{{ errors.comment_default_sort|trans }}</p>{% endif %}
            <label>
                <span>{{ 'Kommentar einklappen ab dieser Zahl von Ablehnungen'|trans }}</span>
                <input type="number" name="comment_rating_hide_threshold" min="0" max="1000" step="1" inputmode="numeric" required value="{{ form.comment_rating_hide_threshold }}">
            </label>
            {% if errors.comment_rating_hide_threshold is defined %}<p class="field-error" role="alert">{{ errors.comment_rating_hide_threshold|trans }}</p>{% endif %}
            <p class="muted">{{ 'Der Wert 0 schaltet das Einklappen aus. Ein Kommentar wird erst eingeklappt, wenn die Ablehnungen den Schwellenwert erreichen und die Ablehnungen die Zustimmungen übersteigen. Der Text bleibt über eine tastaturbedienbare Aufklappsteuerung erreichbar.'|trans }}</p>
            <label>
                <span>{{ 'Kommentare pro Seite'|trans }}</span>
                <input type="number" name="comments_per_page" min="1" max="100" step="1" inputmode="numeric" required value="{{ form.comments_per_page }}">
            </label>
            {% if errors.comments_per_page is defined %}<p class="field-error" role="alert">{{ errors.comments_per_page|trans }}</p>{% endif %}
            <p class="muted">{{ 'Lege fest, wie viele freigegebene Kommentare pro Seite erscheinen. Der Seitenwechsel funktioniert auch ohne JavaScript.'|trans }}</p>
            <input type="hidden" name="public_video_submissions_enabled" value="0">
            <label><input type="checkbox" name="public_video_submissions_enabled" value="1"{% if form.public_video_submissions_enabled == '1' %} checked{% endif %}> {{ 'Öffentliche Videoeinreichungen annehmen'|trans }}</label>
            <input type="hidden" name="public_video_embedding_enabled" value="0">
            <label><input type="checkbox" name="public_video_embedding_enabled" value="1"{% if form.public_video_embedding_enabled == '1' %} checked{% endif %}> {{ 'Eigenen Videoplayer für externe Websites freigeben'|trans }}</label>
            <p class="muted">{{ 'Die Vorgabe für Kommentare betrifft nur neu angelegte Inhalte. Jede Videoeinreichung bleibt bis zur Prüfung unveröffentlicht. Beim Abschalten bleiben bereits wartende Einreichungen erhalten.'|trans }}</p>
            <p class="muted">{{ 'Wenn Gästekommentare deaktiviert sind, dürfen angemeldete Konten weiterhin kommentieren. Änderungen gelten nur für neue Kommentare.'|trans }}</p>
            <div class="form-actions"><button class="button button-primary" type="submit">{{ 'Inhaltseinstellungen speichern'|trans }}</button></div>
        </form>
    </section>

    <section class="admin-panel" aria-labelledby="advertising-options-heading">
        <header class="panel-heading"><h2 id="advertising-options-heading">{{ 'Anzeigen'|trans }}</h2></header>
        <p>{{ 'Verwalte Banner, Player-Anzeigen und datensparsame Auslieferungsberichte im Anzeigenbereich.'|trans }}</p>
        <a class="button button-secondary" href="{{ path('admin_advertising_index') }}">{{ 'Anzeigenverwaltung öffnen'|trans }}</a>
    </section>
{% endblock %}
