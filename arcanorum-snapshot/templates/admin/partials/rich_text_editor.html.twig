{% set editor_id = id %}
{% set label_id = editor_id ~ '-label' %}
<label for="{{ editor_id }}"><span id="{{ label_id }}">{{ label|trans }}</span></label>
<div class="rich-text-widget" data-rich-text-editor>
    <div class="rich-text-toolbar" role="toolbar" aria-label="{{ 'Textformatierung'|trans }}" hidden>
        <button type="button" data-rich-text-command="bold" aria-label="{{ 'Fett'|trans }}" title="{{ 'Fett'|trans }}"><strong>B</strong></button>
        <button type="button" data-rich-text-command="italic" aria-label="{{ 'Kursiv'|trans }}" title="{{ 'Kursiv'|trans }}"><em>I</em></button>
        <button type="button" data-rich-text-command="formatBlock" data-rich-text-value="h2">{{ 'Überschrift'|trans }}</button>
        <button type="button" data-rich-text-command="insertUnorderedList">{{ 'Aufzählung'|trans }}</button>
        <button type="button" data-rich-text-command="insertOrderedList">{{ 'Nummerierung'|trans }}</button>
        <button type="button" data-rich-text-command="formatBlock" data-rich-text-value="blockquote">{{ 'Zitat'|trans }}</button>
        <button type="button" data-rich-text-command="createLink">{{ 'Link einfügen'|trans }}</button>
    </div>
    <div class="rich-text-surface" contenteditable="true" role="textbox" aria-multiline="true" aria-labelledby="{{ label_id }}" data-rich-text-surface hidden>{{ value|rich_text }}</div>
    <textarea id="{{ editor_id }}" name="body" rows="{{ rows }}" maxlength="100000" required>{{ value }}</textarea>
    <small>{{ 'Formatierungen werden beim Speichern auf sichere Elemente und Links begrenzt.'|trans }}</small>
</div>
