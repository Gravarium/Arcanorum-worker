{% extends 'admin/layout.html.twig' %}

{% block admin_title %}{{ is_edit ? 'Seite bearbeiten'|trans : 'Neue Seite'|trans }}{% endblock %}
{% block admin_breadcrumb %}<a href="{{ path('admin_page_index') }}">{{ 'Seiten'|trans }}</a> / {{ is_edit ? 'Bearbeiten'|trans : 'Neue Seite'|trans }}{% endblock %}

{% block admin_content %}
    <div class="page-heading">
        <div>
            <p class="eyebrow">{{ 'Website'|trans }}</p>
            <h1 id="seitenueberschrift">{{ is_edit ? 'Seite bearbeiten'|trans : 'Neue Seite'|trans }}</h1>
            <p class="muted">{{ 'Gestalte eine Inhaltsseite mit sicher formatiertem Text, Suchmaschinenangaben und eigener Navigation.'|trans }}</p>
        </div>
        <a class="button button-secondary" href="{{ path('admin_page_index') }}">{{ 'Zurück zur Übersicht'|trans }}</a>
    </div>

    {% if errors is not empty %}
        <div class="flash-message is-error" role="alert">
            <strong>{{ 'Bitte prüfe die Eingaben.'|trans }}</strong>
            <ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
        </div>
    {% endif %}

    <section class="admin-panel" aria-labelledby="page-form-heading">
        <header class="panel-heading">
            <div>
                <h2 id="page-form-heading">{{ 'Seitendaten'|trans }}</h2>
                <p class="muted">{{ 'Die Adresse wird aus dem Titel gebildet, kann aber bearbeitet werden.'|trans }}</p>
            </div>

            <label>
                <span>{{ 'Autorenangabe'|trans }}</span>
                <input name="author_name" value="{{ values.author_name }}" maxlength="120" required>
            </label>
        </header>

        <form class="admin-form" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_page_save') }}">

            <label>
                <span>{{ 'Titel'|trans }}</span>
                <input name="title" value="{{ values.title }}" maxlength="180" required>
            </label>

            <label>
                <span>{{ 'Permalink'|trans }}</span>
                <input name="slug" value="{{ values.slug }}" maxlength="200" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" aria-describedby="page-slug-help">
                <small id="page-slug-help">{{ 'Leer lassen, um den Permalink aus dem Titel zu bilden. Erlaubt sind Kleinbuchstaben, Ziffern und Bindestriche.'|trans }}</small>
            </label>

            <div class="form-grid">
                <label>
                    <span>{{ 'Kurzbeschreibung'|trans }}</span>
                    <input name="summary" value="{{ values.summary }}" maxlength="500">
                </label>
                <label>
                    <span>{{ 'Status'|trans }}</span>
                    <select name="status">
                        <option value="draft" {{ values.status == 'draft' ? 'selected' : '' }}>{{ 'Entwurf'|trans }}</option>
                        <option value="published" {{ values.status == 'published' ? 'selected' : '' }}>{{ 'Veröffentlicht'|trans }}</option>
                    </select>
                </label>
            </div>

            <div class="form-grid">
                <label>
                    <span>{{ 'Meta-Schlagwörter'|trans }}</span>
                    <input name="meta_keywords" value="{{ values.meta_keywords }}" maxlength="500">
                    <small>{{ 'Suchbegriffe, durch Kommas getrennt.'|trans }}</small>
                </label>
                <label>
                    <span>{{ 'Meta-Beschreibung'|trans }}</span>
                    <textarea name="meta_description" rows="3" maxlength="500">{{ values.meta_description }}</textarea>
                </label>
            </div>

            <div class="form-checks">
                <label><input type="checkbox" name="show_in_menu" value="1" {{ values.show_in_menu ? 'checked' : '' }}> {{ 'Seite im öffentlichen Menü anzeigen'|trans }}</label>
            </div>

            {{ include('admin/partials/rich_text_editor.html.twig', {
                id: 'page-body',
                label: 'Inhalt',
                value: values.body,
                rows: 16,
                image_upload_url: image_upload_url,
                image_upload_token: page_id ? csrf_token('admin_inline_image_upload_page_' ~ page_id) : ''
            }) }}

            <div class="form-actions">
                <button class="button" type="submit">{{ is_edit ? 'Änderungen speichern'|trans : 'Seite speichern'|trans }}</button>
                <a class="button button-secondary" href="{{ path('admin_page_index') }}">{{ 'Abbrechen'|trans }}</a>
            </div>
        </form>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script defer src="{{ asset('admin/rich-text-editor.js') }}"></script>
{% endblock %}
