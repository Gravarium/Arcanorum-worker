<!doctype html>
<html lang="{{ app.request.locale }}" dir="{{ locale_text_direction(app.request.locale) }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <meta name="color-scheme" content="light">
    <title>{{ 'Installationsschritt: Hosting-Sicherheitsprofil'|trans }}</title>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
</head>
<body class="public-site">
<main class="public-main">
    <header class="public-home-heading">
        <p class="eyebrow">Arcanorum</p>
        <h1>{{ 'Installationsschritt: Hosting-Sicherheitsprofil'|trans }}</h1>
        <p>{{ 'Vor der ersten Administratorkontoanlage können Sie nachweisbare Hosting-Fähigkeiten prüfen und optionale Schutzfunktionen auswählen.'|trans }}</p>
    </header>

    {% for message in app.flashes('success') %}
        <p class="status-pill status-pill-success" role="status">{{ message|trans }}</p>
    {% endfor %}

    {% if errors.form is defined %}
        <p class="field-error" role="alert">{{ errors.form|trans }}</p>
    {% endif %}

    <section class="admin-panel" aria-labelledby="mandatory-security-heading">
        <header class="panel-heading"><h2 id="mandatory-security-heading">{{ 'Verbindlicher Basisschutz'|trans }}</h2></header>
        <p>{{ 'Diese Anwendungsschutzmaßnahmen bleiben immer aktiv und können hier nicht abgewählt werden.'|trans }}</p>
        <ul>
            <li>{{ 'Mehr-Faktor-Anmeldung für privilegierte Konten'|trans }}</li>
            <li>{{ 'Serverseitige Rollen- und Berechtigungsprüfungen'|trans }}</li>
            <li>{{ 'CSRF-Schutz für zustandsändernde Formulare'|trans }}</li>
            <li>{{ 'Sichere Sitzungen und Schutz vor Sitzungsfixierung'|trans }}</li>
            <li>{{ 'Eingabevalidierung, sichere Ausgabe und geschützte Uploads'|trans }}</li>
        </ul>
    </section>

    <section class="admin-panel" aria-labelledby="capability-report-heading">
        <header class="panel-heading"><h2 id="capability-report-heading">{{ 'Geprüfte Hosting-Fähigkeiten'|trans }}</h2></header>
        <ul>
            {% for evidence in overview.capabilityReport.all() %}
                <li><strong>{{ evidence.capability.label|trans }}</strong>: {{ evidence.status.label|trans }}</li>
            {% endfor %}
        </ul>
        <p class="muted hosting-capability-explanation">{{ 'Unbekannt heißt: Arcanorum kann diese Fähigkeit derzeit nicht nachweisen. Das bedeutet nicht automatisch, dass der Hoster sie nicht unterstützt.'|trans }}</p>
    </section>


    <section class="admin-panel" id="installer-php-runtime" aria-labelledby="installer-php-runtime-heading">
        <header class="panel-heading"><h2 id="installer-php-runtime-heading">{{ 'PHP-Konfiguration'|trans }}</h2></header>
        <p>{{ 'PHP-Version'|trans }} {{ php_runtime.php_version }} · {{ 'Laufzeit'|trans }} {{ php_runtime.php_sapi }}</p>
        <p class="muted">{{ 'Die Werte stammen aus der aktiven PHP-Weblaufzeit. Webserver- oder Proxygrenzen können zusätzlich enger sein.'|trans }}</p>
        {% if php_runtime.notices is not empty %}
            <aside id="installer-php-runtime-notices" aria-labelledby="installer-php-runtime-notices-heading">
                <h3 id="installer-php-runtime-notices-heading">{{ 'PHP-Sicherheitshinweise'|trans }}</h3>
                {% for notice in php_runtime.notices %}
                    <p class="field-error" role="alert">{{ notice|trans }}</p>
                {% endfor %}
            </aside>
        {% endif %}
        <div class="table-wrap"><table class="admin-table">
            <caption class="visually-hidden">{{ 'Begrenzte PHP-Laufzeitwerte'|trans }}</caption>
            <thead><tr><th scope="col">{{ 'Grenze'|trans }}</th><th scope="col">{{ 'Wert'|trans }}</th></tr></thead>
            <tbody>
                {% for label, value in php_runtime.php_limits %}
                    <tr><th scope="row">{{ label|trans }}</th><td>{{ value|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table></div>
        <h3>{{ 'PHP-Einstellungen'|trans }}</h3>
        <div class="table-wrap"><table class="admin-table">
            <caption class="visually-hidden">{{ 'Ausgewählte PHP-Sicherheits- und Laufzeiteinstellungen'|trans }}</caption>
            <thead><tr><th scope="col">{{ 'Einstellung'|trans }}</th><th scope="col">{{ 'Status'|trans }}</th></tr></thead>
            <tbody>
                {% for label, value in php_runtime.php_settings %}
                    <tr><th scope="row">{{ label|trans }}</th><td>{{ value|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table></div>
        <h3>{{ 'PHP-Erweiterungen'|trans }}</h3>
        <div class="table-wrap"><table class="admin-table">
            <caption class="visually-hidden">{{ 'Verfügbarkeit erforderlicher und optionaler PHP-Erweiterungen'|trans }}</caption>
            <thead><tr><th scope="col">{{ 'Erweiterung'|trans }}</th><th scope="col">{{ 'Status'|trans }}</th></tr></thead>
            <tbody>
                {% for label, enabled in php_runtime.php_extensions %}
                    <tr><th scope="row">{{ label|trans }}</th><td>{{ (enabled ? 'Verfügbar' : 'Nicht verfügbar')|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table></div>
    </section>

    <section class="admin-panel" aria-labelledby="optional-hosting-security-heading">
        <header class="panel-heading"><h2 id="optional-hosting-security-heading">{{ 'Zusätzliche Host-Schutzfunktionen'|trans }}</h2></header>
        <p>{{ 'Nur aktuell verifizierte Funktionen können neu ausgewählt werden. Eine manuelle Auswahl ersetzt keinen technischen Nachweis.'|trans }}</p>
        <p>{{ 'Diese Seite speichert den Auswahlwunsch. Arcanorum verwendet eine Zusatzfunktion erst, wenn ihre Integration eingerichtet und ihre Voraussetzung aktuell nachgewiesen ist.'|trans }}</p>

        <form id="installer-hosting-security-form" method="post" action="{{ path('installer_security_profile_update') }}" class="admin-form">
            <input type="hidden" name="token" value="{{ csrf_token('installer_hosting_security') }}">

            {% for choice in overview.optionalFeatures %}
                {% set feature_id = choice.feature.value %}
                {% set input_id = 'installer-hosting-feature-' ~ feature_id %}
                <div class="form-field">
                    <label for="{{ input_id }}">
                        <input
                            id="{{ input_id }}"
                            name="selected_features[]"
                            type="checkbox"
                            value="{{ feature_id }}"
                            {% if choice.selected %}checked{% endif %}
                            {% if not choice.isAvailable() and not choice.selected %}disabled{% endif %}
                        >
                        <strong>{{ choice.feature.label|trans }}</strong>
                    </label>
                    <p class="muted">{{ choice.feature.description|trans }}</p>
                    <span class="status-pill {{ choice.availability.cssClass() }}">{{ choice.availability.label|trans }}</span>
                    {% if choice.hasSelectionDrift() %}
                        <p class="field-error" role="alert">{{ 'Ausgewählt, aber der aktuelle Hostnachweis fehlt. Die Funktion ist nicht als verfügbar bestätigt. Entfernen Sie die Auswahl oder stellen Sie den Nachweis wieder her.'|trans }}</p>
                    {% endif %}
                </div>
            {% endfor %}

            <div class="form-actions">
                <button class="button button-primary" type="submit">{{ 'Auswahl speichern'|trans }}</button>
            </div>
        </form>
    </section>

    <section class="admin-panel" aria-labelledby="installer-first-admin-next-heading">
        <header class="panel-heading"><h2 id="installer-first-admin-next-heading">{{ 'Installationsschritt: Erstadministrator'|trans }}</h2></header>
        <p>{{ 'Richten Sie das erste Administratorkonto ein und bestätigen Sie die Mehr-Faktor-Anmeldung, bevor das Konto gespeichert wird.'|trans }}</p>
        <p><a class="button button-primary" href="{{ path('installer_administrator_credentials') }}">{{ 'Weiter zur Einrichtung des Administratorkontos'|trans }}</a></p>
    </section>
</main>
</body>
</html>
