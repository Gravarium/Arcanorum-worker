<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.0/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="var/cache/phpunit"
         colors="true"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         beStrictAboutOutputDuringTests="true">
    <php>
        <env name="KERNEL_CLASS" value="App\Kernel" force="true"/>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="APP_DEBUG" value="0" force="true"/>
        <env name="APP_SECRET" value="test-only-placeholder-not-a-secret" force="false"/>
        <env name="DATABASE_URL" value="postgresql://arcanorum_test@127.0.0.1:5432/arcanorum_test?serverVersion=18&amp;charset=utf8" force="false"/>
        <env name="REDIS_URL" value="redis://127.0.0.1:6379" force="false"/>
    </php>
    <testsuites>
        <testsuite name="Arcanorum">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
